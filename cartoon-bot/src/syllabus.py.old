def get_lesson_by_number(lesson_num):
    """Get lesson details by lesson number (1-100)"""
    if lesson_num <= 20:
        level = "basics"
        idx = lesson_num - 1
    elif lesson_num <= 60:
        level = "intermediate"
        idx = lesson_num - 21
    else:
        level = "advanced"
        idx = lesson_num - 61
    
    lessons = SYLLABUS[level]["lessons"]
    if idx < len(lessons):
        return lessons[idx], level
    return None, None

def get_next_lesson(history):
    """Determine next lesson based on history"""
    completed = len([h for h in history if h.get("type") == "lesson"])
    next_num = completed + 1
    
    if next_num > 100:
        next_num = 1  # Loop back or could do revision
    
    lesson, level = get_lesson_by_number(next_num)
    if lesson:
        log(f"Next lesson: #{next_num} - {lesson['title']} ({level})")
        return lesson, next_num, level
    return None, None, None

def is_weekend_day(day_of_week):
    """Check if today is weekend (Saturday=5, Sunday=6)"""
    return day_of_week in (5, 6)

def get_fun_fact_topic():
    """Get a random fun fact topic for weekends"""
    import random
    topics = SYLLABUS["fun_facts"]["topics"]
    return random.choice(topics)

