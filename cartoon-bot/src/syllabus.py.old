        print(f"Lessons: {len(level_data['lessons'])}")
        
        # Show first 3
        for i, lesson in enumerate(level_data['lessons'][:3]):
            print(f"  {lesson['id']}. {lesson['title']}")
    
    print(f"\n\n📺 Weekend Fun Facts")
    print(f"Topics: {len(SYLLABUS['fun_facts']['topics'])}")
